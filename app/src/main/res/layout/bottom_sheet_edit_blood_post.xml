<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/badge_bg"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="রক্তের পোস্ট সম্পাদনা"
        android:textColor="#C62828"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#EEEEEE" />

    <!-- Edit Patient Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="রোগীর পুরো নাম (*):"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditPatientName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="#F8F9FA"
        android:hint="রোগীর নাম লিখুন"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- Edit Blood Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="রক্তের পরিমাণ (*):"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditBloodAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="#F8F9FA"
        android:hint="যেমন: ১ ব্যাগ / ২ ইউনিট"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEditBloodPost"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary_green"
            android:text="আপডেট করুন"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEditBloodPost"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="0.8"
            android:layout_marginStart="6dp"
            android:text="বাতিল"
            android:textColor="#555555"
            android:textSize="14sp"
            app:strokeColor="#CCCCCC"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
