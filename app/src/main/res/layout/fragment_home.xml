<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
        android:id="@+id/swipeRefreshHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollViewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 18 Categories Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="জরুরি সেবাসমূহ"
                    android:textColor="@color/primary_green"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp" />

                <!-- Centered "লালপুর সংবাদ" Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="লালপুর সংবাদ"
                        android:textColor="@color/primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/primary_green" />
                </LinearLayout>

                <!-- News Skeleton Loader -->
                <include
                    android:id="@+id/incNewsSkeleton"
                    layout="@layout/item_news_carousel_skeleton"
                    android:visibility="gone" />

                <!-- News Carousel ViewPager2 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpNewsCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginBottom="20dp" />

                <!-- Centered "লালপুর ওপেন চ্যাট" Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="লালপুর ওপেন চ্যাট"
                        android:textColor="@color/primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/primary_green" />
                </LinearLayout>

                <!-- Open Chat Skeleton Loaders -->
                <LinearLayout
                    android:id="@+id/llHomeChatSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include layout="@layout/item_open_chat_skeleton" />
                    <include layout="@layout/item_open_chat_skeleton" />
                </LinearLayout>

                <!-- Open Chat RecyclerView (Max 10 Items) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeOpenChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- View More Button for Open Chat -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMoreChat"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="View More (আরও দেখুন) ▾"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold"
                    app:strokeColor="@color/primary_green"
                    app:cornerRadius="20dp"
                    android:visibility="gone" />

                <!-- Square WebView Container for Ad -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#EAEAEA">

                            <!-- Placeholder during load -->
                            <LinearLayout
                                android:id="@+id/llAdPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/ivAdLogo"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:src="@drawable/logo2"
                                    android:contentDescription="Loading Ad" />
                            </LinearLayout>

                            <!-- Silent Web Browser -->
                            <WebView
                                android:id="@+id/wvAdBrowser"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</RelativeLayout>
