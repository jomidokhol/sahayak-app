<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sahayak" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:textColor">#212121</item>
        <item name="android:editTextColor">#212121</item>
        <item name="android:textColorHint">#757575</item>
        <item name="fontFamily">@font/bangla_font</item>
        <item name="android:fontFamily">@font/bangla_font</item>
        <item name="materialAlertDialogTheme">@style/CustomDialogTheme</item>
    </style>

    <!-- Force Light Theme Context for 3-Dot Popup Menus -->
    <style name="PopupMenuThemeOverlay" parent="Theme.MaterialComponents.Light">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColor">#212121</item>
    </style>

    <!-- Force Light Theme for Dialogs (Solves White-on-White text issue) -->
    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:background">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>
        <item name="android:textColorPrimary">#006A4E</item> <!-- Title Color -->
        <item name="android:textColorSecondary">#212121</item> <!-- Message Content Color -->
        <item name="android:textColorAlertDialogListItem">#006A4E</item>
        <item name="colorPrimary">@color/primary_green</item> 
        <item name="colorAccent">@color/primary_green</item>
    </style>
</resources>
