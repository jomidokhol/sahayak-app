<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_bg">

    <!-- Red-Green Gradient Header Bar -->
    <LinearLayout
        android:id="@+id/headerCheckout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/header_gradient"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackCheckout"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="পেমেন্ট চেকআউট"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCheckout"
        android:layout_above="@id/btnProceedPayment"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Selected Plan Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="অর্ডার বিবরণ"
                        android:textColor="@color/primary_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/tvCheckoutPlanTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="প্ল্যান: ১ মাস মেয়াদী ভেরিফিকেশন"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCheckoutPlanDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="মেয়াদ: ৩০ দিন"
                        android:textColor="#555555"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCheckoutPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="মোট প্রদেয়: ৳৫০"
                        android:textColor="@color/primary_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Gateway Selector Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পেমেন্ট পদ্ধতি নির্বাচন করুন:"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- bKash Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPaymentBkash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="2.5dp"
                    app:strokeColor="@color/primary_green">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivBkashLogo"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/bkash"
                            android:contentDescription="bKash" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nagad Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPaymentNagad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#CCCCCC">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivNagadLogo"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/nagad"
                            android:contentDescription="Nagad" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Proceed Button (Text changed to "প্রোসিড") -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProceedPayment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary_green"
        android:text="প্রোসিড"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

    <!-- In-App Payment WebView Overlay with Complete Fullscreen Focus -->
    <RelativeLayout
        android:id="@+id/rlPaymentOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone">

        <!-- Overlay Gradient Header -->
        <LinearLayout
            android:id="@+id/headerOverlayBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/header_gradient"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvPaymentOverlayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="পেমেন্ট গেটওয়ে"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClosePaymentOverlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/white"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Loading Animated Logo Placeholder -->
        <LinearLayout
            android:id="@+id/llPaymentPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerOverlayBar"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/ivPaymentLogoPulse"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/flogo"
                android:contentDescription="Loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="সিকিউর গেটওয়ে লোড হচ্ছে..."
                android:textColor="@color/primary_green"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- WebView for Payment Gateway -->
        <WebView
            android:id="@+id/wvPaymentGateway"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerOverlayBar"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
