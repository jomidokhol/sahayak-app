<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Contact Avatar -->
        <ImageView
            android:id="@+id/ivUserContactAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/draft_user"
            android:contentDescription="Avatar" />

        <!-- Details Column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivUserContactAvatar"
            android:layout_toStartOf="@id/btnUserContactMenu"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <!-- Category & Approval Status Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUserContactCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="ডাক্তার"
                    android:textColor="@color/primary_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserContactStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#FFF3E0"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="অপেক্ষমাণ"
                    android:textColor="#E65100"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUserContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="নাম"
                android:textColor="#1E1E1E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserContactTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পদবি বা বিবরণ"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvUserContactPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📞 01711XXXXXX"
                android:textColor="@color/primary_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserContactLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 গোপালপুর, লালপুর"
                android:textColor="#757575"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3-Dot Action Menu Button -->
        <ImageButton
            android:id="@+id/btnUserContactMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="#555555"
            android:contentDescription="Menu" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
