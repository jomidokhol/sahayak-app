<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_bg">

    <!-- Main List Container -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
        android:id="@+id/swipeRefreshChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Skeleton Loading View -->
            <LinearLayout
                android:id="@+id/llChatSkeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="70dp"
                android:visibility="gone">

                <include layout="@layout/item_open_chat_skeleton" />
                <include layout="@layout/item_open_chat_skeleton" />
                <include layout="@layout/item_open_chat_skeleton" />
            </LinearLayout>

            <!-- Empty State View -->
            <TextView
                android:id="@+id/tvEmptyChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="কোনো পোস্ট পাওয়া যায়নি।"
                android:textColor="#757575"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Main Open Chat RecyclerView (Starts with top padding for floating search bar) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOpenChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:paddingTop="68dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Top Search Bar (Smoothly hides on scroll down, reveals on scroll up) -->
    <LinearLayout
        android:id="@+id/llChatSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:padding="12dp"
        android:elevation="4dp"
        android:background="@color/gray_bg">

        <EditText
            android:id="@+id/etChatSearch"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/badge_bg"
            android:backgroundTint="@color/white"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/primary_green"
            app:drawableTint="@color/primary_green"
            android:drawablePadding="10dp"
            android:hint="পোস্টের বক্তব্য বা নাম খুঁজুন..."
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>
