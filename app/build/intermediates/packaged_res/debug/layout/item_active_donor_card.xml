<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#E53935"
    app:cardBackgroundColor="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/donor_card_gradient_bg">

        <!-- Bottom-Right Watermark Graphic (blood.png) -->
        <ImageView
            android:id="@+id/ivActiveDonorWatermark"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-6dp"
            android:alpha="0.22"
            android:scaleType="fitCenter"
            android:src="@drawable/blood"
            android:contentDescription="Watermark" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- 1. Top-Left Large Bold White Blood Group (38sp) -->
            <TextView
                android:id="@+id/tvActiveDonorBloodGroupBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:text="B+"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- Top-Right Share Button -->
            <ImageButton
                android:id="@+id/btnShareDonorCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="#424242"
                android:contentDescription="Share Donor" />

            <!-- 2. Permanent Top-Center: Avatar (56dp) + Name (20sp Bold Black) + Location -->
            <LinearLayout
                android:id="@+id/llActiveDonorUserInfoHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivActiveDonorAvatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/draft_user"
                        android:contentDescription="Avatar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvActiveDonorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="নাম"
                                android:textColor="#1E1E1E"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivActiveDonorVerifiedBadge"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_verified_badge"
                                android:visibility="gone"
                                android:contentDescription="Verified" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvActiveDonorAddressHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="লালপুর, নাটোর"
                            android:textColor="#555555"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Status Capsule & Contact Buttons Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/llActiveDonorUserInfoHeader"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <!-- Readiness Status Capsule with Vector Icon (Zero Emoji) -->
                <LinearLayout
                    android:id="@+id/llActiveDonorStatusCapsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#2E7D32"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:id="@+id/ivActiveDonorStatusIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/white"
                        android:contentDescription="Status Icon" />

                    <TextView
                        android:id="@+id/tvActiveDonorReadinessStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="রক্তদানে সক্ষম"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveDonorLastDonationDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="পূর্বে কখনো রক্তদান করেননি"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Bottom Contact Buttons (Call, WhatsApp, Messenger) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveDonorCall"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#004D36"
                        android:text="CALL"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_phone"
                        app:iconTint="@color/white"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveDonorWhatsApp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:backgroundTint="#25D366"
                        android:text="WHATSAPP"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconTint="@color/white"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveDonorMessenger"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#1877F2"
                        android:text="MESSENGER"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_messenger"
                        app:iconTint="@color/white"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
