<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/badge_bg"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/flogo"
        android:contentDescription="Update Logo" />

    <TextView
        android:id="@+id/tvUpdateDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="নতুন আপডেট পাওয়া গেছে!"
        android:textColor="@color/primary_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="সংস্করণ: v1.1"
        android:textColor="#555555"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="#F8F9FA"
        android:padding="12dp"
        android:text="নতুন সংস্করণে বিভিন্ন বাগ ফিক্স ও গতি বৃদ্ধি করা হয়েছে।"
        android:textColor="#333333"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbUpdateDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary_green"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUpdateProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="0%"
        android:textColor="@color/primary_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartUpdate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary_green"
        android:text="এখনই আপডেট ও ইনস্টল করুন"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
