<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- Modal Card in Center -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeColor="#E8F5E9"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Success Checkmark Badge -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_verified_badge"
                android:contentDescription="Success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="অভিনন্দন! ভেরিফিকেশন সফল"
                android:textColor="#006A4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCelebrationPlanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="১ মাস মেয়াদী ভেরিফিকেশন সক্রিয় হয়েছে"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/tvCelebrationTrxId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TrxID: TXN-12345678"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCelebrationDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="মেয়াদ: ৩০ দিন"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="এখন থেকে আপনার নামের পাশে ভেরিফায়েড ব্যাজ এবং সকল প্রিমিয়াম সুবিধা সক্রিয় থাকবে।"
                android:textColor="#006A4E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCelebrationGoProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/primary_green"
                android:text="প্রোফাইলে যান ➔"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Confetti Layer on Top of the Modal Window -->
    <com.nur.sahayak.utils.ConfettiView
        android:id="@+id/confettiDialogView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
