<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_bg">

    <!-- Red-Green Gradient Header Bar -->
    <LinearLayout
        android:id="@+id/headerCreatePost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/header_gradient"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackCreatePost"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="নতুন পোস্ট তৈরি করুন"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCreatePost"
        android:layout_above="@id/btnSubmitPost"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- User Info Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/ivPostUserAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/draft_user"
                    android:contentDescription="Avatar" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPostUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সম্মানিত ইউজার"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivPostUserVerifiedBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_verified_badge"
                            android:visibility="gone"
                            android:contentDescription="Verified" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPostVisibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="পাবলিক পোস্ট"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded Input Box Supporting Rich Inline Chips -->
            <EditText
                android:id="@+id/etPostContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:background="@drawable/badge_bg"
                android:backgroundTint="@color/white"
                android:gravity="top|start"
                android:hint="আপনার বক্তব্য বা প্রশ্ন লিখুন (সর্বোচ্চ ১০০১ শব্দ)..."
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:padding="16dp"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <!-- Smart Number Detection Suggestion Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetectedNumberHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F0F7F4"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.5dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💡 নম্বর সনাক্ত হয়েছে:"
                            android:textColor="@color/primary_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetectedNumberDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01711XXXXXX"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIgnoreDetectedNumber"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close"
                            app:tint="#666666"
                            android:contentDescription="Ignore" />
                    </LinearLayout>

                    <!-- Action Buttons to convert to Phone / WhatsApp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetAsPhone"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/primary_green"
                            android:text="📞 ফোন বাটন"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetAsWhatsApp"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="#25D366"
                            android:text="💬 WhatsApp বাটন"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Attached Image Preview Container with Auto-Adjusting Aspect Ratio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPostImagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivAttachedPostImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="440dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Attached Image" />

                    <ImageButton
                        android:id="@+id/btnRemoveAttachedImage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="8dp"
                        android:background="@drawable/badge_bg"
                        android:backgroundTint="#CC000000"
                        android:src="@drawable/ic_close"
                        app:tint="@color/white"
                        android:contentDescription="Remove Image" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upload Progress Indicator -->
            <ProgressBar
                android:id="@+id/pbPostUpload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary_green"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Word Counter -->
            <TextView
                android:id="@+id/tvWordCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="শব্দ সংখ্যা: ০ / ১০০১"
                android:textColor="#666666"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Post Creation Tools Toolbar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="পোস্টের অতিরিক্ত টুলস:"
                android:textColor="@color/primary_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- 1. Attach Photo Tool -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolAddPhoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/white"
                    android:text="ছবি"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_image"
                    app:iconTint="@color/primary_green"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="8dp" />

                <!-- 2. Schedule Tool -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolSchedule"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:backgroundTint="@color/white"
                    android:text="সিডিউল"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_schedule"
                    app:iconTint="@color/primary_green"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="8dp" />

                <!-- 3. Temporary Expiry Tool -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolTemporary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:backgroundTint="@color/white"
                    android:text="মেয়াদ"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_timer"
                    app:iconTint="@color/primary_green"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="8dp" />

                <!-- 4. Anonymous Toggle Tool -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolAnonymous"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/white"
                    android:text="গোপন"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_anonymous"
                    app:iconTint="@color/primary_green"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Active Options Badges View -->
            <LinearLayout
                android:id="@+id/llActiveToolBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvActiveScheduleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#E8F5E9"
                    android:textColor="@color/primary_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvActiveExpiryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#FFF3E0"
                    android:textColor="#E65100"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitPost"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary_green"
        android:text="পোস্ট প্রকাশ করুন"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

</RelativeLayout>
