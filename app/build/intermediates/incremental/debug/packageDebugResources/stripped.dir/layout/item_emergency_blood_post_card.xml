<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#E53935"
    app:cardBackgroundColor="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/donor_card_gradient_bg">

        <!-- Bottom-Right Watermark Graphic (blood.png) -->
        <ImageView
            android:id="@+id/ivBloodPostWatermark"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-6dp"
            android:alpha="0.20"
            android:scaleType="fitCenter"
            android:src="@drawable/blood"
            android:contentDescription="Watermark" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- 1. Top-Left: Large Bold White Blood Group (38sp) on Red Gradient Corner -->
            <TextView
                android:id="@+id/tvBloodPostGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:text="B+"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- 2. Patient Name: 28sp Bold Deep Green in the SAME Row with Blood Group -->
            <TextView
                android:id="@+id/tvBloodPostPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tvBloodPostGroup"
                android:layout_alignBaseline="@id/tvBloodPostGroup"
                android:layout_toStartOf="@id/llRightHeaderSection"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="রোগী"
                android:textColor="#004D36"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- 3. Top-Right Section: Creator Info + "X ব্যাগ রক্ত প্রয়োজন" Capsule on the Right -->
            <LinearLayout
                android:id="@+id/llRightHeaderSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:gravity="end"
                android:orientation="vertical">

                <!-- Creator Avatar, Name & 3-Dot Menu Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivBloodPostCreatorAvatar"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/draft_user"
                        android:contentDescription="Avatar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBloodPostCreatorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="রক্তসন্ধানী"
                                android:textColor="#1E1E1E"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivBloodPostVerifiedBadge"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_verified_badge"
                                android:visibility="gone"
                                android:contentDescription="Verified" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBloodPostTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="এখন"
                            android:textColor="#757575"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnBloodPostMenu"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_more_vert"
                        app:tint="#555555"
                        android:contentDescription="Menu" />
                </LinearLayout>

                <!-- "X ব্যাগ রক্ত প্রয়োজন" Capsule on the Right Side -->
                <TextView
                    android:id="@+id/tvBloodPostAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="১ ব্যাগ রক্ত প্রয়োজন"
                    android:textColor="#006A4E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Hospital & Location: Pure White Text with Deep Red Halo/Shadow (dx=0, dy=0) -->
            <LinearLayout
                android:id="@+id/llMiddleDetailsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvBloodPostGroup"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <!-- Hospital Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_hospital"
                        app:tint="@color/white"
                        android:contentDescription="Hospital" />

                    <TextView
                        android:id="@+id/tvBloodPostHospital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="হাসপাতাল"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:shadowColor="#D32F2F"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8" />
                </LinearLayout>

                <!-- Location Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/white"
                        android:contentDescription="Location" />

                    <TextView
                        android:id="@+id/tvBloodPostLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ঠিকানা"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:shadowColor="#D32F2F"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8" />
                </LinearLayout>

            </LinearLayout>

            <!-- Short Description Preview -->
            <TextView
                android:id="@+id/tvBloodPostDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/llMiddleDetailsBlock"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_bg"
                android:backgroundTint="#F8F9FA"
                android:padding="10dp"
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <!-- 5. Bottom Action Buttons: CALL, WHATSAPP, MESSENGER -->
            <LinearLayout
                android:id="@+id/llBloodPostContactButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvBloodPostDescription"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <!-- Call Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBloodPostCall"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#004D36"
                    android:text="CALL"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_phone"
                    app:iconTint="@color/white"
                    app:cornerRadius="8dp" />

                <!-- WhatsApp Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBloodPostWhatsApp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:backgroundTint="#25D366"
                    android:text="WHATSAPP"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconTint="@color/white"
                    app:cornerRadius="8dp" />

                <!-- Messenger Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBloodPostMessenger"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#1877F2"
                    android:text="MESSENGER"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_messenger"
                    app:iconTint="@color/white"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
