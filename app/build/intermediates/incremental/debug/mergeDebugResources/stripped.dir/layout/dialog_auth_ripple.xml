<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Red & Green Dual Concentric Ripple Container -->
        <RelativeLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:gravity="center">

            <!-- Red Outer Ripple -->
            <View
                android:id="@+id/vRippleRed"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_centerInParent="true"
                android:background="@drawable/badge_bg"
                android:backgroundTint="#99F42A41" />

            <!-- Green Inner Ripple -->
            <View
                android:id="@+id/vRippleGreen"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerInParent="true"
                android:background="@drawable/badge_bg"
                android:backgroundTint="#99006A4E" />

            <!-- Center Logo -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerInParent="true"
                android:src="@drawable/flogo"
                android:contentDescription="Logo" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvAuthMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="অথেনটিকেশন ও ডাটা সিঙ্ক হচ্ছে..."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</RelativeLayout>
