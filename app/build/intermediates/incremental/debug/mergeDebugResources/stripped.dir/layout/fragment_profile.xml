<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@color/gray_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Cover & Avatar Container -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/ivCoverPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/draft_cover"
                    android:contentDescription="Cover Banner" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="135dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="3dp"
                    app:strokeColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/ivProfileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/draft_user"
                        android:contentDescription="User Avatar" />
                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

            <!-- User Name with Verified Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সম্মানিত ইউজার"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <ImageView
                    android:id="@+id/ivProfileVerifiedBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_verified_badge"
                    android:visibility="gone"
                    android:contentDescription="Verified Badge" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="user@gmail.com"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Action Buttons Row 1: Edit Profile + Verify + Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:backgroundTint="@color/white"
                    android:text="Edit Profile"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:backgroundTint="#E8F5E9"
                    android:text="ভেরিফাই"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:backgroundTint="@color/white"
                    android:text="Settings"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:strokeColor="#CCCCCC"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Action Buttons Row 2: User Contact Update + Logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUserContacts"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/white"
                    android:text="আমার কন্টাক্ট"
                    android:textColor="@color/primary_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_phone"
                    app:iconTint="@color/primary_green"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/accent_red"
                    android:text="Logout"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- 1. Personal Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ব্যক্তিগত তথ্যসমূহ"
                        android:textColor="@color/primary_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#E0E0E0" />

                    <!-- Mobile Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="মোবাইল নম্বর:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileMobile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Age & DOB -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="বয়স ও জন্মতারিখ:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileAgeDob"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="ওজন (কেজি):"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="জেন্ডার / লিঙ্গ:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Blood Group -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="ব্লাড গ্রুপ:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileBloodGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/accent_red"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="ঠিকানা:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="তথ্য নেই"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Contact Links -->
                    <LinearLayout
                        android:id="@+id/llProfileContactLinksRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="বিকল্প যোগাযোগ:"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileContactLinks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#006A4E"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Blood Donor Card with Diagonal Gradient & Bottom-Right Watermark -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp">

                <!-- The Card with Diagonal Red-White Gradient Background -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBloodDonorProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#E53935"
                    app:cardBackgroundColor="@android:color/transparent">

                    <RelativeLayout
                        android:id="@+id/rlDonorCardRoot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/donor_card_gradient_bg">

                        <!-- Bottom-Right Watermark Graphic (blood.png) -->
                        <ImageView
                            android:id="@+id/ivDonorCardWatermark"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-6dp"
                            android:layout_marginBottom="-6dp"
                            android:alpha="0.22"
                            android:scaleType="fitCenter"
                            android:src="@drawable/blood"
                            android:contentDescription="Watermark" />

                        <!-- State A: Unregistered State -->
                        <LinearLayout
                            android:id="@+id/llDonorUnregisteredState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="26dp"
                            android:paddingHorizontal="20dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/blood"
                                android:contentDescription="Blood Icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="ডোনার হিসেবে যুক্ত হন"
                                android:textColor="#C62828"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="জরুরি প্রয়োজনে রক্তদান করে জীবন বাঁচান।"
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditDonorInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="#E53935"
                                android:text="তথ্য যুক্ত করুন ➔"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="21dp" />
                        </LinearLayout>

                        <!-- State B: Registered Donor Card -->
                        <RelativeLayout
                            android:id="@+id/llDonorRegisteredState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <!-- 1. Top-Left: Large Bold White Blood Group (38sp) on Red Gradient Corner -->
                            <TextView
                                android:id="@+id/tvDonorBloodGroupBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="4dp"
                                android:text="B+"
                                android:textColor="#FFFFFF"
                                android:textSize="38sp"
                                android:textStyle="bold" />

                            <!-- 2. Permanent Top-Center: Avatar (56dp) + Name (20sp Bold Black) + Location -->
                            <LinearLayout
                                android:id="@+id/llDonorUserInfoHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentTop="true"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/ivDonorAvatar"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:src="@drawable/draft_user"
                                        android:contentDescription="Avatar" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:orientation="vertical">

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/tvDonorName"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="নূর মোহাম্মদ"
                                                android:textColor="#1E1E1E"
                                                android:textSize="20sp"
                                                android:textStyle="bold" />

                                            <ImageView
                                                android:id="@+id/ivDonorVerifiedBadge"
                                                android:layout_width="18dp"
                                                android:layout_height="18dp"
                                                android:layout_marginStart="6dp"
                                                android:src="@drawable/ic_verified_badge"
                                                android:visibility="gone"
                                                android:contentDescription="Verified" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/tvDonorAddressHeader"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="লালপুর, নাটোর"
                                            android:textColor="#555555"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- 3. Middle & Bottom Normal Mode: Status Capsule, Date & Contact Buttons -->
                            <LinearLayout
                                android:id="@+id/llDonorStatusNormalView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/llDonorUserInfoHeader"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp">

                                <!-- Readiness Status Capsule (Icon + Text) -->
                                <LinearLayout
                                    android:id="@+id/llDonorStatusCapsule"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/badge_bg"
                                    android:backgroundTint="#E64A19"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="5dp">

                                    <ImageView
                                        android:id="@+id/ivDonorStatusIcon"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_timer_white"
                                        android:contentDescription="Status Icon" />

                                    <TextView
                                        android:id="@+id/tvDonorReadinessStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="অপেক্ষমাণ (আর 76 দিন বাকি)"
                                        android:textColor="@color/white"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Subtitle Date Text -->
                                <TextView
                                    android:id="@+id/tvDonorLastDonationDateText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="সর্বশেষ রক্তদান: 10 August, 2026"
                                    android:textColor="#212121"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <!-- Bottom Contact Buttons -->
                                <LinearLayout
                                    android:id="@+id/llDonorContactButtons"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="12dp">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnDonorCall"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="4dp"
                                        android:backgroundTint="#004D36"
                                        android:text="CALL"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        app:icon="@drawable/ic_phone"
                                        app:iconTint="@color/white"
                                        app:cornerRadius="8dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnDonorWhatsApp"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="1"
                                        android:layout_marginHorizontal="2dp"
                                        android:backgroundTint="#25D366"
                                        android:text="WHATSAPP"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        app:icon="@drawable/ic_whatsapp"
                                        app:iconTint="@color/white"
                                        app:cornerRadius="8dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnDonorMessenger"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="1"
                                        android:layout_marginStart="4dp"
                                        android:backgroundTint="#1877F2"
                                        android:text="MESSENGER"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        app:icon="@drawable/ic_messenger"
                                        app:iconTint="@color/white"
                                        app:cornerRadius="8dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- 4. Date Edit View with Explicit Rules Text -->
                            <LinearLayout
                                android:id="@+id/llDonorStatusEditView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/llDonorUserInfoHeader"
                                android:background="@drawable/badge_bg"
                                android:backgroundTint="#F8F9FA"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:layout_marginTop="8dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="সর্বশেষ রক্তদানের তারিখ নির্ধারণ করুন:"
                                    android:textColor="#212121"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSelectLastDonationDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="38dp"
                                    android:layout_marginTop="4dp"
                                    android:backgroundTint="#FFFFFF"
                                    android:text="তারিখ নির্বাচন করুন 📅"
                                    android:textColor="@color/black"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:strokeColor="#CCCCCC"
                                    app:strokeWidth="1dp"
                                    app:cornerRadius="6dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="• সর্বনিম্ন তিন মাস পর পর রক্তদান করা যায়।\n• পূর্বে কোন দিন দান না করে থাকলে ফাঁকা রাখুন।"
                                    android:textColor="#666666"
                                    android:textSize="11sp"
                                    android:lineSpacingExtra="2dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="6dp">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnSaveLastDonationDate"
                                        android:layout_width="0dp"
                                        android:layout_height="36dp"
                                        android:layout_weight="1"
                                        android:backgroundTint="@color/primary_green"
                                        android:text="সংরক্ষণ"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        app:cornerRadius="6dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnClearLastDonationDate"
                                        android:layout_width="0dp"
                                        android:layout_height="36dp"
                                        android:layout_weight="1"
                                        android:layout_marginStart="4dp"
                                        android:backgroundTint="#C62828"
                                        android:text="মুছুন"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        app:cornerRadius="6dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnCancelLastDonationEdit"
                                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="36dp"
                                        android:layout_weight="0.8"
                                        android:layout_marginStart="4dp"
                                        android:text="বাতিল"
                                        android:textColor="#333333"
                                        android:textSize="12sp"
                                        app:strokeColor="#CCCCCC"
                                        app:cornerRadius="6dp" />
                                </LinearLayout>
                            </LinearLayout>

                        </RelativeLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Floating Overlapping Buttons on Card Border -->
                <LinearLayout
                    android:id="@+id/llDonorActionButtonsTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:elevation="18dp"
                    app:layout_constraintTop_toTopOf="@id/cardBloodDonorProfile"
                    app:layout_constraintEnd_toEndOf="@id/cardBloodDonorProfile"
                    android:layout_marginTop="-16dp"
                    android:layout_marginEnd="16dp">

                    <ImageButton
                        android:id="@+id/btnDonorVisibility"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/badge_bg"
                        android:backgroundTint="#E8F5E9"
                        android:src="@drawable/ic_eye_open"
                        app:tint="@color/primary_green"
                        android:elevation="8dp"
                        android:contentDescription="Visibility" />

                    <ImageButton
                        android:id="@+id/btnEditLastDonation"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/badge_bg"
                        android:backgroundTint="#FFEBEE"
                        android:src="@drawable/ic_calendar_edit"
                        app:tint="#C62828"
                        android:elevation="8dp"
                        android:contentDescription="Edit Date" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- User Posts Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="পোস্ট"
                    android:textColor="@color/primary_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/llProfilePostsSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/item_open_chat_skeleton" />
                    <include layout="@layout/item_open_chat_skeleton" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoProfilePosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="আপনার এখনো কোনো পোস্ট নেই।"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProfilePosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <!-- Footer Section with Developer Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeveloperPage"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Developer Info"
                        android:textColor="@color/primary_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTerms"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Terms &amp; Rules"
                        android:textColor="#666666"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
